@@ -1421,3 +1424,26 @@ fn _assert_send() {
     is_send::<Thread>();
     let _ = MoveList::new();
 }
+
+#[cfg(test)]
+mod correction_tests {
+    use super::*;
+
+    #[test]
+    fn correction_learns_a_constant_bias_without_forgetting_at_zero_residual() {
+        let board = Board::startpos();
+        for target in [-48, 48] {
+            let mut thread = Thread::new(0);
+            for _ in 0..1024 {
+                let corrected = thread.corrected(&board, 0, 0);
+                thread.update_correction(&board, 8, target - corrected, 0);
+            }
+            let corrected = thread.corrected(&board, 0, 0);
+            assert!((corrected - target).abs() <= 1, "{corrected} vs {target}");
+            for _ in 0..128 {
+                thread.update_correction(&board, 8, 0, 0);
+            }
+            assert_eq!(thread.corrected(&board, 0, 0), corrected);
+        }
+    }
+}
