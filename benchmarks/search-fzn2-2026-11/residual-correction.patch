diff --git a/src/search.rs b/src/search.rs
index 98a2515..77746b3 100644
--- a/src/search.rs
+++ b/src/search.rs
@@ -392,7 +392,10 @@ impl Thread {
         let scaled = (diff * CORR_GRAIN).clamp(-CORR_MAX, CORR_MAX);
         let w = (depth + 1).min(16);
         let upd = |e: &mut i32| {
-            *e = ((*e * (256 - w) + scaled * w) / 256).clamp(-CORR_MAX, CORR_MAX);
+            // Learn the remaining prediction error. Once corrected eval
+            // agrees with search, a zero residual preserves the learned bias.
+            let bonus = scaled * w / 256;
+            *e = (*e + bonus - *e * bonus.abs() / CORR_MAX).clamp(-CORR_MAX, CORR_MAX);
         };
         let h = &mut self.histories;
