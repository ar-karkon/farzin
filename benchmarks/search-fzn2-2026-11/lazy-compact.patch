+    fn assert_full_accumulator(net: &Network, acc: &mut Accumulators, board: &Board, ply: usize) {
+        assert_eq!(acc.evaluate(net, board, ply), net.evaluate(board));
+        // Check every hidden lane as well: clipping in the output layer
+        // could otherwise conceal an incorrect feature update.
+        for p in [WHITE, BLACK] {
+            let (b, m) = net.key(p, board);
+            let mut expected = net.ft_bias.clone();
+            let mut occ = board.occupied();
+            while occ != 0 {
+                let sq = pop_lsb(&mut occ);
+                add_row(
+                    &mut expected,
+                    net.row(feature(p, b, m, board.mailbox[sq] as usize, sq)),
+                );
+            }
+            assert_eq!(
+                acc.stack[ply][p],
+                expected,
+                "ply {ply}, perspective {p}, {}",
+                board.to_fen()
+            );
+        }
+    }
