+    #[test]
+    fn refresh_invalidates_pending_updates_with_same_shape_new_weights() {
+        let net = random_net(32, 8, "4m");
+        let mut other = random_net(32, 8, "4m");
+        other.ft_bias.iter_mut().for_each(|v| *v += 7);
+        other.ft_weights.iter_mut().for_each(|v| *v /= 2);
+        let root = Board::startpos();
+        let mv = root.parse_move("e2e4").unwrap();
+        let child = root.make_move(mv);
+        let mut acc = Accumulators::new();
+        acc.refresh(&net, &root, 0);
+        acc.push(&net, &root, &child, mv, 1);
+        acc.refresh(&other, &root, 0);
+        acc.push(&other, &root, &child, mv, 1);
+        assert_full_accumulator(&other, &mut acc, &child, 1);
+    }
