+    #[test]
+    fn lazy_updates_across_skipped_nodes_nulls_and_siblings() {
+        for name in ["1", "1m", "4m", "16m", "32m"] {
+            let net = random_net(64, 8, name);
+            let mut acc = Accumulators::new();
+            for fen in [
+                "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
+                "4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 1",
+                "4k3/P7/8/8/8/8/7p/4K3 w - - 0 1",
+                "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+            ] {
+                let mut board = Board::from_fen(fen).unwrap();
+                acc.refresh(&net, &board, 0);
+                let mut seed = 31usize;
+                for ply in 1..100 {
+                    let moves = legal_moves(&board);
+                    if moves.is_empty() {
+                        break;
+                    }
+                    // Materialize some siblings and leave others pending,
+                    // then overwrite that same stack slot with the real move.
+                    if ply % 7 == 0 || ply == 1 {
+                        for &mv in &moves {
+                            let child = board.make_move(mv);
+                            acc.push(&net, &board, &child, mv, ply);
+                            assert_full_accumulator(&net, &mut acc, &child, ply);
+                        }
+                    }
+                    seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+                    if ply % 5 == 0 && !board.in_check() {
+                        board = board.make_null();
+                        acc.push_null(ply);
+                    } else {
+                        let mv = moves[(seed >> 33) % moves.len()];
+                        let child = board.make_move(mv);
+                        acc.push(&net, &board, &child, mv, ply);
+                        board = child;
+                    }
+                    // Includes chains of uncomputed ordinary/null moves and
+                    // king bucket/mirror changes without Board snapshots.
+                    if ply % 9 == 0 || ply == 99 {
+                        assert_full_accumulator(&net, &mut acc, &board, ply);
+                    }
+                }
+            }
+        }
+    }
