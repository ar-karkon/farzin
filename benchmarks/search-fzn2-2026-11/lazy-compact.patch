+    fn materialize(&mut self, net: &Network, board: &Board, ply: usize, p: usize) {
+        let mut ancestor = ply;
+        while !self.computed[ancestor][p] {
+            if self.dirty[ancestor].refresh[p] {
+                // Refresh the requested position directly. Intermediate
+                // positions across a bucket boundary need not be evaluated
+                // or retained as complete Board snapshots.
+                self.refresh_side(net, board, ply, p);
+                self.computed[ply][p] = true;
+                return;
+            }
+            debug_assert!(ancestor > 0, "root accumulator must be refreshed");
+            ancestor -= 1;
+        }
+        let (b, m) = net.key(p, board);
+        for j in ancestor + 1..=ply {
+            let d = self.dirty[j];
+            let row = |(code, sq): (u8, u8)| net.row(feature(p, b, m, code as usize, sq as usize));
+            let adds = d.adds.map(row);
+            let subs = d.subs.map(row);
+            let (prev, rest) = self.stack.split_at_mut(j);
+            apply(
+                &mut rest[0][p],
+                &prev[j - 1][p],
+                &adds[..d.na as usize],
+                &subs[..d.ns as usize],
+            );
+            self.computed[j][p] = true;
         }
     }
 
